<?xml version='1.1' encoding='UTF-8'?>
<!-- Job definition: a Pipeline that loads its script from this repo (SCM).
     The actual pipeline logic lives in jenkins/pipelines/sops-decrypt.Jenkinsfile. -->
<flow-definition plugin="workflow-job">
  <description>Decrypt one or all SOPS-encrypted secret files using the sops-age-key credential. Pipeline from SCM: jenkins/pipelines/sops-decrypt.Jenkinsfile</description>
  <keepDependencies>false</keepDependencies>
  <definition class="org.jenkinsci.plugins.workflow.cps.CpsScmFlowDefinition" plugin="workflow-cps">
    <scm class="hudson.plugins.git.GitSCM" plugin="git">
      <configVersion>2</configVersion>
      <userRemoteConfigs>
        <hudson.plugins.git.UserRemoteConfig>
          <url>https://github.com/mogambo-project/mogambo-kubernetes.git</url>
        </hudson.plugins.git.UserRemoteConfig>
      </userRemoteConfigs>
      <branches>
        <hudson.plugins.git.BranchSpec>
          <name>*/master</name>
        </hudson.plugins.git.BranchSpec>
      </branches>
      <doGenerateSubmoduleConfigurations>false</doGenerateSubmoduleConfigurations>
      <submoduleCfg class="empty-list"/>
      <extensions/>
    </scm>
    <scriptPath>jenkins/pipelines/sops-decrypt.Jenkinsfile</scriptPath>
    <lightweight>true</lightweight>
  </definition>
  <triggers/>
  <disabled>false</disabled>
</flow-definition>
